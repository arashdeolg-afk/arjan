# Deol Tech configuration. Copy to `.env` and edit before the first start.

# REQUIRED. Signs session cookies and CSRF tokens. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# If this is left unset the app generates one and stores it in the database,
# which works but means the value lives next to the data it protects.
DEOLTECH_SECRET=

# Where the SQLite database lives. Inside Docker this must stay on the volume.
DEOLTECH_DB=/data/deoltech.db

# Market data mode:
#   auto      Finviz, falling back to the simulator when it is unreachable
#   live      Finviz only — fails loudly rather than serving simulated prices
#   synthetic simulator only (demos, training, air-gapped installs)
DEOLTECH_FEED=auto

# Optional. With a Finviz Elite token the adapter uses the supported CSV
# export instead of scraping the screener: more reliable, and permitted.
FINVIZ_AUTH_TOKEN=

DEOLTECH_HOST=0.0.0.0
DEOLTECH_PORT=8000
