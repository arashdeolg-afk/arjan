# Jedar AI server environment.
# Copy to .env and fill in real values. Never commit .env.
#
# The OpenAI key lives ONLY here, on the server. It must never be copied into
# mobile/.env, any EXPO_PUBLIC_* variable, app.json, or mobile source code.
OPENAI_API_KEY=sk-server-only
PORT=8787
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Comma-separated list of allowed browser origins (native apps send no Origin).
CORS_ORIGIN=http://localhost:8081
# Long random string used to hash anonymous install IDs into OpenAI safety identifiers.
SAFETY_ID_SALT=replace-with-a-long-random-value
# Optional: NODE_ENV=production disables the demo text response used when no key is set.
NODE_ENV=development
