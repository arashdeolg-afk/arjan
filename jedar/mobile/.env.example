# Jedar AI mobile environment.
# Copy to .env. Every EXPO_PUBLIC_* value is compiled INTO the app bundle and is
# readable by anyone who installs the app.
#
# WARNING: OPENAI_API_KEY must NEVER appear in this file, in app.json, or anywhere
# in the mobile project. The mobile app only ever talks to the Jedar server, which
# holds the key. Use your computer's LAN IP (not localhost) so a physical device
# can reach the server.
EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:8787
